#!/bin/sh /etc/rc.common
# Copyright (C) 2016-2017 Hsing-wang Liao <kuoruan@gmail.com>
# Licensed to the public under the Apache License 2.0.
#
# Adapted from the official OpenWrt net/aria2 init script (openwrt/packages,
# branches openwrt-24.10 and openwrt-25.12 — both identical). The UCI schema
# remains compatible with upstream aria2 configs; copy /etc/config/aria2 to
# /etc/config/aria2-next to reuse an existing configuration with aria2-next.
#
# Compatibility additions for aria2-static deployments:
#   - 'download_dir' is accepted as a synonym for 'dir'.
#   - 'dht_enable'  is accepted as a synonym for 'enable_dht'.
#   - Persistent engine state is kept below each instance's config directory.
#   - Removed username/password RPC authentication fails closed.
#   - Version 3 RPC TLS settings fail closed; use a TLS reverse proxy.
#   - Renamed state, seeding, and peer-ID options retain UCI aliases.
#
# All standard procd/rc.common subcommands are auto-provided:
#   start | stop | restart | reload | enable | disable | enabled |
#   running | status | trace | info

START=99
USE_PROCD=1

NAME=aria2-next
PROG=/usr/bin/aria2-next

_info() {
	logger -p daemon.info -t "$NAME" "$*"
}

_err() {
	logger -p daemon.err -t "$NAME" "$*"
}

_make_dir() {
	local d
	for d in "$@"; do
		if [ ! -d "$d" ]; then
			mkdir -p "$d" 2>/dev/null || return 1
		fi
	done

	return 0
}

_create_file() {
	touch "$@" 2>/dev/null
}

_change_owner() {
	local u="$1"; shift

	local d
	for d in "$@"; do
		if [ -f "$d" ]; then
			chown "$u" "$d" 2>/dev/null || return 1
		elif [ -d "$d" ]; then
			chown -R "$u" "$d" 2>/dev/null || return 1
		fi
	done

	return 0
}

_change_file_mode() {
	local mod="$1"; shift
	chmod "$mod" "$@" 2>/dev/null
}

_reset_dir_mode() {
	local d
	for d in "$@"; do
		if [ -d "$d" ]; then
			find "$d" -type d -exec chmod 755 {} \; 2>/dev/null
			find "$d" -type f -exec chmod 644 {} \; 2>/dev/null
		fi
	done
}

append_options() {
	local o; local v; local name
	for o in "$@"; do
		eval "v=\"\${$o}\""
		if [ -n "$v" ]; then
			name="$(printf '%s' "$o" | tr '_' '-')"
			printf '%s=%s\n' "$name" "$v" >>"$config_file_tmp"
		fi
	done
}

append_setting() {
	local s="$1"
	[ -n "$s" ] && \
		printf '%s\n' "$s" >>"$config_file_tmp"
}

append_header() {
	local h="$1"
	[ -n "$h" ] && \
		printf 'header=%s\n' "$h" >>"$config_file_tmp"
}

validate_rpc_settings() {
	# Match upstream config parsing: trim each line/name/value and ignore
	# comments. Inspect the complete file so multiline extra_settings cannot
	# bypass the security checks. Never print an option value (it may be secret).
	local invalid require_token
	require_token=0
	if [ "$rpc_auth_method" = "token" ] || \
	   { [ -z "$rpc_auth_method" ] && [ -n "$rpc_secret" ]; }; then
		require_token=1
	fi
	if ! invalid="$(awk -v require_token="$require_token" '
		function trim(value) {
			sub(/^[[:space:]]+/, "", value)
			sub(/[[:space:]]+$/, "", value)
			return value
		}
		{
			line = trim($0)
			if (line == "" || substr(line, 1, 1) == "#") next
			equals = index(line, "=")
			if (!equals) next
			name = trim(substr(line, 1, equals - 1))
			value = trim(substr(line, equals + 1))
			if (name == "rpc-secret") secret = value
			if ((name == "rpc-secure" && value != "false") ||
			    ((name == "rpc-certificate" || name == "rpc-private-key") && value != "") ||
			    name == "rpc-user" || name == "rpc-passwd") {
				invalid = name
				exit
			}
		}
		END {
			if (invalid != "") print invalid
			else if (require_token && secret == "") print "rpc-secret"
		}
	' "$1")"; then
		_err "Could not validate generated RPC settings."
		return 1
	fi
	case "$invalid" in
		rpc-secure|rpc-certificate|rpc-private-key)
			_err "Built-in RPC TLS is no longer supported; remove $invalid and use a TLS reverse proxy with rpc_secret."
			return 1
			;;
		rpc-user|rpc-passwd)
			_err "RPC username/password authentication is no longer supported; remove $invalid and configure token authentication with rpc_secret."
			return 1
			;;
		rpc-secret)
			_err "RPC token authentication requires a non-empty rpc-secret after extra_settings."
			return 1
			;;
	esac
	return 0
}

aria2_validate() {
	uci_load_validate "$NAME" aria2 "$1" "$2" \
		'enabled:bool:0' \
		'enable_logging:bool' \
		'enable_proxy:bool' \
		'config_dir:string:/var/etc/aria2-next' \
		'user:string' \
		'all_proxy:string' \
		'all_proxy_passwd:string' \
		'all_proxy_user:string' \
		'auto_save_interval:range(0,600)' \
		'bt_enable_lpd:or("true","false")' \
		'bt_detach_seed_only:or("true","false")' \
		'bt_load_saved_metadata:or("true","false")' \
		'bt_prioritize_piece:string' \
		'bt_max_open_files:uinteger' \
		'bt_max_peers:uinteger' \
		'bt_peer_id_prefix:string' \
		'bt_remove_unselected_file:or("true","false")' \
		'bt_request_peer_speed_limit:string' \
		'bt_save_metadata:or("true","false")' \
		'bt_seed_unverified:or("true","false")' \
		'bt_stop_timeout:uinteger' \
		'bt_tracker:list(string)' \
		'ca_certificate:file' \
		'certificate:file' \
		'check_certificate:or("true","false"):true' \
		'check_integrity:or("true","false")' \
		'connect_timeout:uinteger' \
		'dht_listen_port:string' \
		'dir:string' \
		'disable_ipv6:or("true","false")' \
		'disk_cache:string' \
		'dns_over_https:string' \
		'detach_share_only:or("true","false")' \
		'enable_dht:or("true","false")' \
		'enable_dht6:or("true","false")' \
		'enable_peer_exchange:or("true","false")' \
		'event_poll:or("epoll","kqueue","port","poll","select")' \
		'file_allocation:or("none","prealloc","trunc","falloc")' \
		'follow_torrent:or("true","false","mem")' \
		'force_save:or("true","false")' \
		'http_accept_gzip:or("true","false")' \
		'http_no_cache:or("true","false")' \
		'listen_port:string' \
		'log:string' \
		'log_level:or("debug","info","notice","warn","error")' \
		'lowest_speed_limit:string' \
		'max_concurrent_downloads:uinteger' \
		'max_connection_per_server:uinteger' \
		'max_download_limit:string' \
		'max_overall_download_limit:string' \
		'max_overall_upload_limit:string' \
		'max_tries:uinteger' \
		'max_upload_limit:string' \
		'min_split_size:string' \
		'pause:or("true","false")' \
		'pause_metadata:or("true","false")' \
		'peer_id_prefix:string' \
		'private_key:file' \
		'retry_wait:uinteger' \
		'rpc_auth_method:or("none","user_pass","token")' \
		'rpc_certificate:file' \
		'rpc_listen_all:or("true","false"):true' \
		'rpc_listen_port:range(1024,65535)' \
		'rpc_passwd:string' \
		'rpc_private_key:file' \
		'rpc_secret:string' \
		'rpc_secure:or("true","false")' \
		'rpc_user:string' \
		'save_session_interval:uinteger' \
		'seed_ratio:ufloat' \
		'seed_time:ufloat' \
		'split:uinteger' \
		'state_save_interval:range(1,600)' \
		'timeout:uinteger' \
		'user_agent:string' \
		'download_dir:string' \
		'dht_enable:or("true","false")'
}

aria2_start() {
	local section="$1"
	[ "$2" = "0" ] || { _err "Validation failed."; return 1; }

	# ── aria2-static legacy compatibility shim ──
	# Older aria2-static configs used `download_dir` and `dht_enable`.
	# Map them onto the upstream OpenWrt key names if the upstream key
	# is unset. This keeps existing /etc/config/aria2 files working
	# without any user action.
	[ -n "$dir" ] || dir="$download_dir"
	if [ -z "$enable_dht" ]; then
		enable_dht="${dht_enable:-true}"
	fi
	[ -n "$detach_share_only" ] || detach_share_only="$bt_detach_seed_only"
	[ -n "$bt_peer_id_prefix" ] || bt_peer_id_prefix="$peer_id_prefix"
	[ -n "$state_save_interval" ] || state_save_interval="$auto_save_interval"

	[ "$enabled" = "1" ] || { _info "Instance \"$section\" disabled."; return 1; }
	[ -n "$dir" ] || { _err "Please set download dir."; return 1; }
	[ -d "$dir" ] || { _err "Please create download dir first."; return 1; }
	if [ -n "$state_save_interval" ]; then
		case "$state_save_interval" in
			*[!0-9]*)
				_err "state_save_interval (or legacy auto_save_interval) must be between 1 and 600 seconds."
				return 1
				;;
		esac
		if [ "$state_save_interval" -lt 1 ] || [ "$state_save_interval" -gt 600 ]; then
			_err "state_save_interval (or legacy auto_save_interval) must be between 1 and 600 seconds; 0 is no longer supported."
			return 1
		fi
	fi

	if [ "$rpc_auth_method" = "user_pass" ] || [ -n "$rpc_user" ] || [ -n "$rpc_passwd" ]; then
		_err "RPC username/password authentication is no longer supported; configure token authentication with rpc_secret."
		return 1
	fi
	if [ "$rpc_auth_method" = "token" ] && [ -z "$rpc_secret" ]; then
		_err "RPC token authentication requires rpc_secret."
		return 1
	fi
	if [ "$rpc_secure" = "true" ] || [ -n "$rpc_certificate" ] || [ -n "$rpc_private_key" ]; then
		_err "Built-in RPC TLS is no longer supported; remove rpc_secure/rpc_certificate/rpc_private_key and use a TLS reverse proxy with rpc_secret."
		return 1
	fi

	config_file="$config_dir/$NAME.conf.$section"
	config_file_tmp="$config_dir/$NAME.conf.tmp"
	session_file="$config_dir/$NAME.session.$section"
	state_dir="$config_dir/state.$section"

	_make_dir "$config_dir" "$state_dir" || {
		_err "Can't create config or state dir: $config_dir, $state_dir"
		return 1
	}

	_create_file "$session_file" "$config_file" "$config_file_tmp" || {
		_err "Can't create files: $session_file, $config_file, $config_file_tmp"
		return 1
	}

	# create tmp file
	cat >"$config_file_tmp" <<-EOF
		# Auto generated file, changes to this file will be lost.
	EOF

	append_setting "dir=$dir"
	append_setting "enable-rpc=true"
	append_setting "rpc-allow-origin-all=true"
	append_options "rpc_listen_all"
	append_setting "quiet=true"
	append_setting "continue=true"
	append_setting "input-file=$session_file"
	append_setting "save-session=$session_file"
	append_setting "state-dir=$state_dir"

	if [ -z "$enable_logging" ]; then
		append_options "log" "log_level"
	elif [ "$enable_logging" = "1" ]; then
		log=${log:-"/var/log/aria2.log"}

		local log_dir
		log_dir="$(dirname "$log")"

		_make_dir "$log_dir" || {
			_err "Can't create log dir: $log_dir"
			return 1
		}

		# create or clear log file
		echo >"$log"

		append_setting "log=$log"
		append_options "log_level"
	fi

	if [ -z "$enable_proxy" ] || [ "$enable_proxy" = "1" ]; then
		append_options "all_proxy" "all_proxy_user" "all_proxy_passwd"
	fi

	if [ -z "$rpc_auth_method" ]; then
		if [ -n "$rpc_secret" ]; then
			append_setting "rpc-secret=$rpc_secret"
		else
			_info "It is recommended to set RPC secret."
		fi
	elif [ "$rpc_auth_method" = "token" ]; then
		append_setting "rpc-secret=$rpc_secret"
	fi

	if [ ."$check_certificate" = ."true" ]; then
		append_setting "check-certificate=true"
		append_options "ca_certificate"
	elif [ ."$check_certificate" = ."false" ]; then
		append_setting "check-certificate=false"
	fi

	if [ -n "$enable_dht" ]; then
		append_setting "enable-dht=$enable_dht"
	fi

	if [ ."$enable_dht6" = ."true" ] && [ ."$disable_ipv6" != ."true" ]; then
		append_setting "enable-dht6=true"
	fi

	if [ -n "$bt_tracker" ]; then
		local bt_tracker_list; local t
		for t in $bt_tracker; do
			if [ -z "$bt_tracker_list" ]; then
				bt_tracker_list="$t"
			else
				bt_tracker_list="$bt_tracker_list,$t"
			fi
		done

		append_setting "bt-tracker=$bt_tracker_list"
	fi

	append_options "state_save_interval" "bt_enable_lpd" "bt_max_open_files" "bt_max_peers" \
		"bt_remove_unselected_file" "bt_request_peer_speed_limit" "bt_prioritize_piece" \
		"bt_stop_timeout" "detach_share_only" "bt_save_metadata" "bt_load_saved_metadata" \
		"bt_seed_unverified" "certificate" "check_integrity" "connect_timeout" "dht_listen_port" \
		"disable_ipv6" "disk_cache" "dns_over_https" "enable_peer_exchange" "event_poll" "file_allocation" \
		"follow_torrent" "force_save" "http_accept_gzip" "http_no_cache" "listen_port" \
		"lowest_speed_limit" "max_concurrent_downloads" "max_connection_per_server" \
		"max_download_limit" "max_overall_download_limit" "max_overall_upload_limit" "max_tries" \
		"max_upload_limit" "min_split_size" "pause" "pause_metadata" "bt_peer_id_prefix" "private_key" \
		"retry_wait" "rpc_listen_port" "save_session_interval" "seed_ratio" "seed_time" "split" "timeout" \
		"user_agent"

	config_list_foreach "$section" "header" append_header
	config_list_foreach "$section" "extra_settings" append_setting
	if ! validate_rpc_settings "$config_file_tmp"; then
		rm -f "$config_file_tmp"
		return 1
	fi

	sed '/^$/d' "$config_file_tmp" >"$config_file"
	rm -f "$config_file_tmp"

	_reset_dir_mode "$config_dir"
	_change_file_mode 600 "$config_file"

	if [ -n "$user" ]; then
		if ( user_exists "$user" && _change_owner "$user" "$config_dir" "$log" ); then
				_info "Aria2 will run with user '$user'."
				if [ "$user" != "root" ]; then
					_info "Please make sure user '$user' has write access to download dir: $dir"
				fi
		else
			_info "Setting run user to '$user' failed, default user will be used."
			user=
		fi
	fi

	procd_open_instance "$NAME.$section"
	procd_set_param command "$PROG"
	procd_append_param command --conf-path="$config_file"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_set_param file "$config_file"
	[ -n "$user" ] && \
		procd_set_param user "$user"

	procd_add_jail "$NAME.$section" log
	procd_add_jail_mount "/usr/lib/ossl-modules"
	# Static OpenSSL still reads target CA data for HTTPS and DoH verification.
	[ ! -d /etc/ssl ] || procd_add_jail_mount "/etc/ssl"
	procd_add_jail_mount "$ca_certificate" "$certificate" "$private_key"
	procd_add_jail_mount_rw "$dir" "$config_dir" "$log"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
	procd_add_validation aria2_validate
}

start_service() {
	config_load "$NAME"
	config_foreach aria2_validate "aria2" aria2_start
}
